# JASA Data Hub — 環境変数サンプル
# これらを設定すると本番DB（Supabase）+ ゲートに切り替わる。
# 未設定ならデモ（インメモリ・Cookieロール切替・認証なし）で動作する。

# --- Prisma / Postgres（Supabase）---
# DATABASE_URL: アプリ実行時の接続。Supabase の「Connection pooler」を推奨。
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"
# DIRECT_URL: マイグレーション用。
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# --- 共有パスワードゲート（運営向けの軽量認証）---
# 設定すると、未認証アクセスは /login のパスワード入力に飛ばされる。
# 本番では推測されにくい値にし、Vercel の環境変数にも同じ値を設定する。
APP_PASSWORD="change-me"

# --- Supabase Auth（Phase 2 の団体ユーザー向け。実ログインUI実装後にON）---
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
